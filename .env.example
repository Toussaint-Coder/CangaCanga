# ---------------------------------------------------------------------------
# CangaCanga environment variables
#
# Copy this file to `.env` and fill in the values. Anything the mobile client
# needs at runtime MUST be prefixed with EXPO_PUBLIC_ (Expo only inlines those
# into the JS bundle). Build-time-only secrets are left unprefixed.
#
# NEVER commit the real `.env` file (it is gitignored).
# ---------------------------------------------------------------------------

# --- Supabase (Auth + Postgres + Realtime + Storage) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Auth ---
# Domain backing the phone->pseudo-email auth accounts. Must be a REAL,
# resolvable domain (Supabase performs a live DNS lookup and rejects
# example/test/non-resolvable domains). No email is ever sent to it because
# email confirmation is disabled. Defaults to gmail.com if unset.
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=gmail.com

# --- Mapbox ---
# Public token (pk.*) used at runtime by the maps SDK / REST APIs.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token
# Secret download token (sk.*) used ONLY at native build time. Build-time only.
MAPBOX_DOWNLOAD_TOKEN=sk.your_download_token

# --- Cloudflare R2 (profile pictures) ---
# The client only needs the PUBLIC bucket URL (to display images). All R2
# credentials live server-side as Edge Function secrets — NEVER ship them in
# the app bundle. Set them with:
#   supabase secrets set --project-ref <ref> \
#     R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_BUCKET_NAME=... R2_PUBLIC_URL=...
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
